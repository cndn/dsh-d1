{
  "name": "dsh-d1",
  "version": "0.1.0",
  "description": "Cloudflare D1 tools for the DeepSeek Harness: d1_list/query/exec/schema/stats/health over the D1 HTTP API — read-only first, lexical read-only guard, write-approval gate, row clamping, CSV/JSON output.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dsh-plugin",
    "cloudflare",
    "d1",
    "sqlite",
    "database"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cndn/dsh-d1.git"
  },
  "homepage": "https://github.com/cndn/dsh-d1#readme",
  "bugs": {
    "url": "https://github.com/cndn/dsh-d1/issues"
  }
}
